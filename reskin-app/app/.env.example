# Copy to app/.env and fill in your keys — or just add them in the app under
# Settings → API keys. Anything set here pre-fills those fields on first run.
# Never commit app/.env (it's gitignored).

# REQUIRED — powers every reskin and Retouch (Gemini image edit).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# REQUIRED — fal.ai key for Bria background removal (clean part edges during
# rebake and after Retouch). Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# OPTIONAL & PRIVATE — your own SAM segmentation server. Only the "SAM"
# segmentation method and the Magic-select tool use it. Treat as a secret;
# do not commit a real URL.
SAM_SERVER_URL=
